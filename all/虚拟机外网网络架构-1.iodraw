          <mxGeometry x="440" y="240" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- 物理路由器 -->
        <mxCell id="router" value="物理路由器&#xa;192.168.101.1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
