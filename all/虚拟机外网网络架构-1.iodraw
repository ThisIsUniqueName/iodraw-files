<mxfile host="app.diagrams.net" modified="2026-06-03T00:00:00.000Z" agent="5.0" etag="drawio-import" version="22.1.0" type="device">
  <diagram name="CloudPods-Traefik架构" id="cloudpods-traefik">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 互联网 -->
