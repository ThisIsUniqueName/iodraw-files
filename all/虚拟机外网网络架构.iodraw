<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36" version="24.7.17">
  <diagram name="Cloudpods-Traefik单公网架构" id="cloudpods01">
    <mxGraphModel dx="1728" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="inet" value="【互联网】所有域名A记录→运营商公网IP" style="rounded=1;fillColor=#ffeeee;strokeColor=#ff6666;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="30" y="30" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="router" value="物理网关路由器\n192.168.101.1\nDNAT:公网80/443→192.168.101.200:80/443\n【无其他端口映射】" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="360" y="30" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="link-inet-router" value="" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="inet" target="router" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="group-default" value="VPC-default(宿主机物理网段192.168.101.0/24)" style="group;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="360" y="160" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="Traefik代理VM\nIP:192.168.101.200\nDocker部署Traefik\n✅七层HTTP/HTTPS域名分流\n✅四层TCP(SNI)RDP/MySQL分流" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=10;" parent="group-default" vertex="1">
          <mxGeometry x="30" y="40" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="host" value="宿主机192.168.101.101\n开启ip_forward=1\nCloudpods底层分布式SNAT" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontSize=9;" parent="group-default" vertex="1">
          <mxGeometry x="30" y="170" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="link-router-traefik" value="80/443端口DNAT转发" style="endArrow=block;html=1;strokeWidth=2;" parent="1" source="router" target="traefik" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="group-a" value="VPC-A｜网段：192.168.5.0/24、192.168.10.0/24" style="group;fillColor=#fff;strokeColor=#0066cc;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="720" y="30" width="380" height="260" as="geometry" />
        </mxCell>
        <mxCell id="a-web1" value="Web-VM01\n192.168.5.20:80\n域名：vm01.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-a" vertex="1">
          <mxGeometry x="30" y="30" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-rdp1" value="Win-RDP01\n192.168.5.21:3389\n域名：rdp01.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-a" vertex="1">
          <mxGeometry x="200" y="30" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a-dbweb" value="DB面板VM\n192.168.10.15:8080\n域名：db.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-a" vertex="1">
          <mxGeometry x="30" y="120" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="group-b" value="VPC-B｜网段：192.168.6.0/24、192.168.16.0/24、192.168.5.0/24(同A网段)" style="group;fillColor=#fff;strokeColor=#cc3300;html=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="720" y="320" width="380" height="260" as="geometry" />
        </mxCell>
        <mxCell id="b-web1" value="Web-VM02\n192.168.6.30:80\n域名：vm02.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-b" vertex="1">
          <mxGeometry x="30" y="30" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-rdp1" value="Win-RDP02\n192.168.6.31:3389\n域名：rdp02.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-b" vertex="1">
          <mxGeometry x="200" y="30" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b-mysql" value="MySQL数据库\n192.168.16.22:3306\n域名：mysql01.xxx.com" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=9;" parent="group-b" vertex="1">
          <mxGeometry x="30" y="120" width="145" height="70" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-a1" value="HTTP域名转发" style="endArrow=block;dashed=1;strokeColor=#0066cc;html=1;" parent="1" source="traefik" target="a-web1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-a2" value="TCP-SNI域名转发(443)" style="endArrow=block;dashed=1;strokeColor=#0066cc;html=1;" parent="1" source="traefik" target="a-rdp1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-a3" value="HTTP域名转发" style="endArrow=block;dashed=1;strokeColor=#0066cc;html=1;" parent="1" source="traefik" target="a-dbweb" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-b1" value="HTTP域名转发" style="endArrow=block;dashed=1;strokeColor=#cc3300;html=1;" parent="1" source="traefik" target="b-web1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-b2" value="TCP-SNI域名转发(443)" style="endArrow=block;dashed=1;strokeColor=#cc3300;html=1;" parent="1" source="traefik" target="b-rdp1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="link-traefik-b3" value="TCP-SNI数据库转发(443)" style="endArrow=block;dashed=1;strokeColor=#cc3300;html=1;" parent="1" source="traefik" target="b-mysql" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="关键说明：\n1、多VPC重复网段(192.168.5.0/24)依靠Traefik域名区分访问，规避静态路由冲突\n2、仅公网80/443两个端口承载全部20+台VM外网访问\n3、所有业务VM安全组仅放行来源：192.168.101.200内网入站，不暴露公网端口" style="rounded=1;fillColor=#ffffcc;strokeColor=#e69138;html=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="30" y="620" width="1070" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
