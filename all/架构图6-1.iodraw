        <!-- 底部备注 -->
        <mxCell id="note-info" value="架构说明：&#xa;1.不同VPC允许同私有网段，依托EIP+域名区分访问，无需配置私有网段静态路由&#xa;2.全业务仅公网80/443，SSH受限运维源IP，收敛公网暴露面&#xa;3.数据库无EIP，仅同VPC内网访问，安全隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde6;strokeColor=#e6b34c;fontSize=10;" parent="1" vertex="1"><mxGeometry x="300" y="100" width="950" height="85" as="geometry"/></mxCell>
