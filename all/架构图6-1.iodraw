  <diagram name="CloudPods-Traefik-EIP-优化版" id="cloudpods-traefik-eip-fixed">
    <mxGraphModel dx="4609" dy="2458" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 新增：边界防火墙（安全优化） -->
        <mxCell id="firewall" value="边界安全防火墙&#xa;仅放行80/443，2222限制运维IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#cc0000;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="600" y="95" width="130" height="55" as="geometry" />
        </mxCell>
        <!-- 互联网 -->
        <mxCell id="internet" value="互联网用户" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="600" y="30" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="DNS 解析&#xa;(A记录 → 唯一公网IP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="600" y="170" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="public-ip" value="公网 IP&#xa;(全局唯一)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="600" y="245" width="130" height="55" as="geometry" />
        </mxCell>
        <!-- 物理路由器 -->
        <mxCell id="router" value="物理路由器&#xa;192.168.101.1&#xa;DNAT：80/443→Traefik集群VIP&#xa;2222仅运维源IP→VIP:22" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="545" y="335" width="240" height="115" as="geometry" />
        </mxCell>
        <!-- 优化：Traefik主备集群（替换单机，高可用） -->
        <mxCell id="traefik-group" value="Traefik主备代理集群&#xa;集群VIP：192.168.101.10&#xa;节点1：192.168.101.2｜节点2：192.168.101.3&#xa;内置WAF+自动SSL+TCP路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="510" y="490" width="310" height="125" as="geometry" />
        </mxCell>
        <mxCell id="traefik-proxy" value="七层+四层统一转发&#xa;域名→对应EIP地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="traefik-group" vertex="1">
          <mxGeometry x="90" y="35" width="130" height="65" as="geometry" />
        </mxCell>
        <!-- 新增：运维监控平台 -->
        <mxCell id="monitor" value="监控&日志平台&#xa;Prometheus+Loki&#xa;全链路指标采集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9d2e9;strokeColor=#76a5af;fontSize=10;" parent="1" vertex="1">
