        <mxCell id="legend-http" value="实线：公网→代理HTTP/HTTPS" style="line;strokeWidth=2;html=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="190" height="18" as="geometry"/></mxCell>
        <mxCell id="legend-traefik-eip" value="蓝实线：Traefik→EIP内网转发" style="line;strokeWidth=2;strokeColor=#0000cc;html=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="90" width="190" height="18" as="geometry"/></mxCell>
        <mxCell id="legend-nat" value="蓝虚线：宿主机DNAT/NAT转换" style="line;strokeWidth=2;strokeColor=#0000cc;dashed=1;html=1;fontSize=10;" parent="1" vertex="1"><mxGeometry x="40" y="120" width="190" height="18" as="geometry"/></mxCell>
