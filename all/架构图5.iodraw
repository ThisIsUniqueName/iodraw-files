        <mxCell id="traefik-server" value="Traefik 服务器 (192.168.101.2)&#xa;• 运行 Traefik 代理&#xa;• 可选：SSH 端口转发（22→EIP:22）&#xa;• 路由可达 EIP 子网" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="500" width="290" height="110" as="geometry" />
